# Copy to .env and change every value. .env is gitignored.

# Neo4j password (user is always "neo4j"). At least 8 characters.
NEO4J_PASSWORD=change-me-neo4j

# HMAC-SHA256 key that signs and verifies JWTs. Must be at least 32 bytes.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-bytes

# AES key (any string of 32+ characters) that encrypts 2FA secrets in Neo4j.
# Generate one with: openssl rand -base64 48
DATA_ENCRYPTION_KEY=change-me-to-another-long-random-secret-32-bytes

# First administrator (can add / edit / delete movies). Leave the password empty to skip.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@neo4flix.local
ADMIN_PASSWORD=

# HTTPS. Dev: run scripts/generate-dev-cert.sh (creates ./certs).
# Production with Let's Encrypt: set DOMAIN and LETSENCRYPT_EMAIL, run the certbot profile, then copy the
# certificate into ./certs with "cp -L" (Let's Encrypt's live/ folder only holds symlinks). See README.
DOMAIN=
LETSENCRYPT_EMAIL=
HTTP_PORT=80
HTTPS_PORT=443
