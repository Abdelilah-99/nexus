<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Shared parent of every backend service: one version, one build configuration -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.buy02</groupId>
  <artifactId>buy-02</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>buy-02</name>
  <description>Buy02 marketplace microservices</description>

  <properties>
    <!-- Overridden by nexus/maven/settings.xml (NEXUS_URL) or -Dnexus.url=... -->
    <nexus.url>http://localhost:8081</nexus.url>
  </properties>

  <!-- Where "mvn deploy" publishes; the ids match the servers in nexus/maven/settings.xml -->
  <distributionManagement>
    <repository>
      <id>nexus-releases</id>
      <name>Buy02 releases</name>
      <url>${nexus.url}/repository/buy02-releases/</url>
    </repository>
    <snapshotRepository>
      <id>nexus-snapshots</id>
      <name>Buy02 snapshots</name>
      <url>${nexus.url}/repository/buy02-snapshots/</url>
    </snapshotRepository>
  </distributionManagement>

  <build>
    <pluginManagement>
      <plugins>
        <!-- mvn versions:set -DnewVersion=x.y.z changes the version of every module at once -->
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>versions-maven-plugin</artifactId>
          <version>2.25.1</version>
          <configuration>
            <generateBackupPoms>false</generateBackupPoms>
            <processAllModules>true</processAllModules>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- Records the commit each artifact was built from (git.properties inside the jar) -->
      <plugin>
        <groupId>io.github.git-commit-id</groupId>
        <artifactId>git-commit-id-maven-plugin</artifactId>
        <version>10.0.1</version>
        <executions>
          <execution>
            <goals>
              <goal>revision</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <generateGitPropertiesFile>true</generateGitPropertiesFile>
          <failOnNoGitDirectory>false</failOnNoGitDirectory>
          <includeOnlyProperties>
            <includeOnlyProperty>git.branch</includeOnlyProperty>
            <includeOnlyProperty>git.commit.id.abbrev</includeOnlyProperty>
            <includeOnlyProperty>git.commit.time</includeOnlyProperty>
            <includeOnlyProperty>git.dirty</includeOnlyProperty>
            <includeOnlyProperty>git.tags</includeOnlyProperty>
          </includeOnlyProperties>
        </configuration>
      </plugin>
      <!-- Records the artifact version and build time (META-INF/build-info.properties) -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>build-info</id>
            <goals>
              <goal>build-info</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <modules>
    <module>discovery</module>
    <module>gateway</module>
    <module>user-service</module>
    <module>product-service</module>
    <module>media-service</module>
    <module>order-service</module>
  </modules>
</project>
